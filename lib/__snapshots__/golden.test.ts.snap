exports[`the config music video: what a wrong value is told 1`] = `
[
  "config.json: videoAspect must be an aspect ratio like "16:9", "9:16" or "2:3", got "wide"",
  "config.json: contextFrames must be 0 (off) or 5 + 17·k frames - 22 or 39 - got 10",
  "config.json: finalFps must be 24 (off) or a frame rate frame interpolation reaches from 24, e.g. 48 or 60, got 50",
  "config.json: finish: sharpen must be between 0 and 1, got 2",
  "config.json: finish: unknown field(s) sharp - known are blackLevel, whiteLevel, contrast, saturation, sharpen, colorMatch, colorReference, grain",
  "config.json: finish must be true, false or an object like {"sharpen": 0.3}, got "yes"",
  "config.json: interpolationModel must be a file name in ComfyUI's models/frame_interpolation/, got """,
  "config.json: leakRetries must be a whole number, 0 or more, got -1",
  "config.json: pinStartFrame must be true or false, got "yes"",
  "config.json: videoWorkflow: no workflow comfy/workflows/nope.ts",
  "config.json: seed must be -1 or a whole number >= 0, got 1.5",
]
`;

